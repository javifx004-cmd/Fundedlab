# Copia este archivo a .env (no se sube al repositorio) o pon estas variables en tu hosting.
BASE_URL=https://curso.tudominio.com
# Clave para descifrar content/ (te la di al crear la app; sin ella no se puede leer el curso)
CONTENT_KEY=
# Stripe → Developers → API keys
STRIPE_SECRET_KEY=sk_live_...
# Stripe → Developers → Webhooks → endpoint https://TU_DOMINIO/api/stripe/webhook
# Eventos: checkout.session.completed, checkout.session.async_payment_succeeded, charge.refunded, charge.dispute.created
STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe → Product catalog → el curso → precio (price_...)
STRIPE_PRICE_ID=price_...
COURSE_PRICE_LABEL=197 €
# Resend (https://resend.com) para los correos de acceso; el dominio del remitente debe estar verificado
RESEND_API_KEY=re_...
MAIL_FROM=Funded Lab <curso@tudominio.com>
# Administrador: acceso gratis sin caducidad y panel de alumnos en /admin (varios correos separados por comas)
ADMIN_EMAILS=tu@correo.com
# Contraseña del panel de alumnos (mínimo 8 caracteres)
ADMIN_PASSWORD=
ACCESS_MONTHS=3
MAX_DEVICES=2
DATA_DIR=./data
